{
  "name": "bidvector-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "bid-vector V2 운영자 화면 (ADR 0011). 화면 구현은 M7/7E — 7A 는 골격과 게이트뿐이다.",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gate:src-tree": "node scripts/check-src-tree.mjs",
    "gate:boundary-canary": "node scripts/boundary-canary.mjs",
    "api:types": "openapi-typescript ../openapi/bidvector-operator-api.yaml -o src/api/generated/operator-api.ts",
    "api:types:check": "node scripts/check-api-types.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
