# 로컬 작업 산출물 — 리뷰 대상 아님 (B2: clean-tree 게이트)
_workspace/
.omc/

# 기존 프로젝트 참조용 symlink — V2 저장소의 일부가 아님
bid-vector

# codex 리뷰 레인의 로컬 실행 산출물
*.raw-output.txt

# 커밋된 도구를 돌리면 생기는 바이트코드 (`fixtures/tools/` 는 모듈을 import 한다)
__pycache__/

# M2/2A — ml-engine 은 pyproject.toml 기반 별도 패키지(ADR 0006 D-8). 가상환경·테스트 캐시·
# 빌드 메타데이터는 로컬 산출물이지 계약이 아니다. Python 생성 stub 은 pytest fixture 가
# 시스템 임시 디렉터리에 만들어 저장소 안에 아예 생기지 않는다(conftest.py).
ml-engine/.venv/
ml-engine/.pytest_cache/
ml-engine/*.egg-info/
# M5/5A — `src/` layout(`[tool.setuptools.packages.find] where=["src"]`)에서는 editable
# install 이 egg-info 를 `ml-engine/src/ml_engine.egg-info/`에 만든다(직계가 아니라 한 겹
# 더 들어간 자리 — 실측, 위 패턴은 안 잡는다).
ml-engine/src/*.egg-info/
ml-engine/.ruff_cache/
ml-engine/.mypy_cache/

# M5/5A — 계약 재수출(D-5A-0 (b), verifier r1 F-2 뒤 위치 정정). `grpc_tools.protoc` 생성
# stub 은 `ml_engine` 패키지 트리 **밖**, `ml-engine/.contracts-generated/`에 둔다 — 트리
# 안에 두면 `ml_engine.contracts._generated`라는 Python import 경로가 생겨 forbidden 계약의
# 열거를 우회할 수 있었다(F-2, 재현 확인). 트리 밖이면 그 경로 자체가 없다. 디렉터리
# 통째로 VCS 밖 — `.gitkeep` 불필요(이전 판이 적었던 「디렉터리 부재 시 세그폴트」는 옛 상대
# import 코드 기준이었고 현재 코드로는 재현되지 않는다, `tests/gates/test_generated_not_tracked.py`
# 가 `git ls-files`로 빈 것을 단언한다).
ml-engine/.contracts-generated/

# 전역 gitignore(~/.gitignore_global)가 CLAUDE.md를 제외하지만,
# 이 프로젝트에서는 역할별 진입점 문서라 커밋 대상이다 (README '문서 읽는 순서')
!CLAUDE.md

# Gradle 산출물. **앵커 없는 `build/` 를 쓰지 않는다** — 그 형태는 경로 어디에서나 매치해
# 패키지 디렉터리(`.../kotlin/bidvector/build/`)까지 삼킨다. Gradle 의 build 디렉터리는 언제나
# 프로젝트 루트에 있으므로 그 자리만 적는다. 모듈을 더 깊이 중첩하면 그 자리를 여기 추가한다.
/build/
/*/build/
/.gradle/
/*/.gradle/
# KGP 가 만드는 세션 디렉터리. `build/`·`.gradle/` 과 같은 가족이고 같은 이유로 앵커한다 —
# `build-logic/.kotlin/` 은 in_scope 아래라 무시되지 않으면 clean-tree 게이트에 걸린다.
/.kotlin/
/*/.kotlin/
!gradle/wrapper/gradle-wrapper.jar
