# M7/7F 본편 — 프록시 site 의 **공유 본문**. 로컬(`docker/proxy.Caddyfile`)과 운영
# (`docker/proxy.prod.Caddyfile`) 두 site 가 이 파일을 `import` 한다 — 로그 필터·보안 헤더·
# 관리 경로 404·라우팅을 두 벌로 두지 않는다(D-7F2-2 (A) — 「7F-local 과의 구성 등식」을 복사가
# 아니라 공유로 지킨다). 두 site 가 다른 것은 TLS 와 HSTS 와 리스너뿐이고, 그 등식을
# `tools/prod-proxy-sites-check.sh` 가 `caddy adapt` JSON 에서 구조로 잰다.
#
# 이 파일은 site 블록 **안**에 붙여지는 지시어들이다(전역 옵션·site 주소를 두지 않는다).

# 접근 로그에서 **헤더를 지운다.** Caddy 는 `Authorization`·`Cookie` 를 가리지만 이
# 스택의 운영자 자격은 **custom 헤더**로 오므로 기본 로그에 평문으로 남는다(실측).
# 필드 하나를 열거해 지우는 대신 헤더 객체 전체를 지운다 — 뒤에 헤더가 늘어도 자동으로
# 로그 밖이다(열거가 아니라 구성). 요청 URI·상태·소요는 남으므로 진단은 그대로 된다.
log {
	format filter {
		wrap console
		fields {
			request>headers delete
			resp_headers delete
		}
	}
}

# 응답 헤더. `defer` 로 **상류 응답을 덮어쓴다** — app 쪽 Spring Security 가 같은 이름을
# 자기 값으로 보내면 두 값이 실리거나 상류 값이 이기므로, 한 자리에서 정해지게 한다.
#
# **정직한 상태(검토 r2)**: 오늘 그 상류 거동은 **실재하지 않는다**. 내부망에서 app 의
# `/api/strategy` 응답 헤더를 직접 떠 보면 아래 네 이름도 `Server` 도 하나도 없다(실측).
# 그래서 `defer` 를 떼어도 프록시 응답은 이름마다 1개로 똑같고, 스모크의 「이름당 1개」
# 축은 오늘 아무것도 운동시키지 못한다 — 그 축의 값은 **app 이 뒷날 보안 헤더를 켜는
# 변경에 대한 회귀 가드**다. `defer` 자체의 필요성은 아직 측정되지 않았다.
header {
	defer
	-Server
	X-Content-Type-Options nosniff
	Referrer-Policy no-referrer
	X-Frame-Options DENY
	# web 번들이 실제로 쓰는 출처에 맞춘 최소 CSP — 같은 출처의 스크립트·스타일
	# (vite 가 내는 해시 파일 둘)과 CSS 안의 data: 이미지, 같은 출처 fetch(`/api/**`,
	# `src/api/client.ts` 의 baseUrl 이 `/`)뿐이다. 바깥 출처·inline·eval 은 없다.
	Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	# **HSTS 는 이 공유 본문에 두지 않는다.** 로컬은 보내지 않는다 — HSTS 는 포트가 아니라
	# **host 단위**로 걸리므로 `localhost` 에 한 번 보내면 그 브라우저의 모든 localhost 평문
	# 개발 서버가 함께 막히고, 로컬 CA 에는 HSTS 가 지킬 대상도 없다. 로컬에서 이 헤더가
	# **없음**을 `tools/local-tls-smoke.sh` 가 단언한다. 운영은 `docker/proxy.prod.Caddyfile` 이
	# 따로 붙인다(D-7F2-1 Q-7) — 그 차이를 `tools/prod-proxy-sites-check.sh` 가 등식으로 잠근다.
}

# 관리 경로는 프록시를 지나지 못한다. **구속력 있는 차단은 이 블록이 아니라 상류 집합**
# 이다: 이 프록시의 상류는 web 과 app 의 **API 포트** 둘뿐이고 관리 포트는 상류가 아니다
# (`compose.local-tls.yaml` 의 env 둘, 스모크가 구조로 단언한다). 이 블록은 그 위에
# 덧대는 명시적 404 다 — 없으면 `/actuator/health` 가 SPA fallback 으로 200 셸을 받아
# 「무엇이 막았는가」가 응답에서 사라진다.
handle /actuator* {
	respond 404
}

handle /api/* {
	reverse_proxy {$BIDVECTOR_PROXY_APP_UPSTREAM}
}

handle {
	reverse_proxy {$BIDVECTOR_PROXY_WEB_UPSTREAM}
}
