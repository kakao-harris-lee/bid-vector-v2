# M7/7F-local — 리버스 프록시 설정. `docker/proxy.Dockerfile` 이 이미지에 굽는다.
#
# 이 프로필에서 **host 포트를 여는 것은 이 서비스 하나**다(`docker/compose.local-tls.yaml` 이
# app·ml-serving 의 publish 를 비운다). app·postgres·web 은 compose 내부망에만 있다.
#
# 위협 모델(scope.md (0)): 막는 것은 ① 내부 서비스의 host 직접 노출 ② 관리 경로가 프록시를
# 지나는 것 ③ 경로 정규화 우회 ④ 평문 ⑤ root 실행. 막지 않는 것은 운영 TLS·인증서 수명
# (7F 본편)과 DDoS.
{
	admin off
	persist_config off
	# 평문 리다이렉트 리스너를 만들지 않는다 — 이 프록시는 **https 리스너 하나**만 연다.
	# 우회 ④ 의 선택은 「리다이렉트」가 아니라 **「거부」**다: 평문 리스너가 없으므로 평문
	# 요청은 TLS 핸드셰이크에서 끊기고, 어떤 경로도 평문으로 응답되지 않는다. 비-root 로
	# 돌기 때문에 80 을 bind 할 수도 없다(두 사유가 같은 방향이다). 운영 도메인에서의
	# 80 리다이렉트 여부는 실 host 와 함께 정할 일이다(7F 본편).
	auto_https disable_redirects
}

# 도메인은 환경변수이고 **기본값은 `localhost`** 다 — 운영 도메인 값을 저장소에 두지 않는다.
# 포트에는 기본값을 적지 않는다(그 자리는 `tools/local-tls-smoke.sh` 하나). 값을 요구하는 것은
# compose 의 `${BIDVECTOR_PROXY_HTTPS_PORT:?}` 이고, **이 참조 자신은 fail-closed 가 아니다** —
# `web.Caddyfile` 의 같은 자리 주석에 실측이 있다.
https://{$BIDVECTOR_PROXY_DOMAIN:localhost}:{$BIDVECTOR_PROXY_HTTPS_PORT} {
	# 로컬 CA — Caddy 가 **실행 시** 발급한다. 저장소에 키도 인증서도 없고, 컨테이너를 다시
	# 만들면 새로 생긴다(볼륨을 붙이지 않는다 — 잔여 0). 신뢰 방법은 runbook 의 7F-local 절.
	tls internal

	# 나머지 본문(로그·헤더·관리 경로·라우팅)은 운영 site 와 **공유**한다.
	import proxy.site.caddy
}
